rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /admins/{email} {
      allow read: if true;
      allow write: if false;
    }

    match /customVideos/{userId}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /routines/{routineId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.createdBy);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.createdBy;
    }

    match /config/masterLibrary {
      allow read: if true;
      allow write: if true;
    }

    match /publicVideos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /menus/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /sharedMenus/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /programs/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /recipes/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /research/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /clientProfiles/{clientId} {
      // Any authenticated user can read/write
      // (trainers query their clients, clients read their own doc)
      allow read, write: if request.auth != null;
    }

    match /foods/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /foods_he/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /menus_he/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /programs_he/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /recipes_he/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /masterLibrary_he/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /workoutSessions/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /clientMeasurements/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
